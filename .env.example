PORT=3000

# Out-of-process plugin tuning (all optional, sensible defaults if omitted)
# How long to wait for a remote plugin to ack an on-message dispatch (ms).
PLUGIN_ACK_TIMEOUT_MS=5000
# How long a dispatched-but-unanswered request stays eligible for a reply
# before being dropped (ms).
PLUGIN_PENDING_REPLY_TTL_MS=900000
# How recently a remote plugin must have sent a heartbeat to show as
# "healthy" in the UI (ms).
PLUGIN_HEARTBEAT_STALE_MS=90000
